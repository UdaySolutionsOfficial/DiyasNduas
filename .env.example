# ==========================================
# DIYAS N DUAS — FIREBASE ENVIRONMENT CONFIGURATION
# ==========================================
# Populate these variables with your Firebase project credentials.
# Do NOT commit real production credentials to public source repositories.

# Firebase Web App Configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_VAPID_KEY=YOUR_FIREBASE_VAPID_PUBLIC_KEY

# Firebase Realtime Database URL
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Store Info Defaults
VITE_STORE_NAME="Diyas N Duas"
VITE_SUPPORT_PHONE="+91 9876543210"
