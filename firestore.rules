rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Any authenticated user logged in via Firebase Auth has Admin write permissions
    function isAdmin() {
      return request.auth != null;
    }

    // Products collection: Public read, stock quantity update on orders, Admin full write
    match /products/{productId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity', 'updatedAt']) || isAdmin();
      allow create, delete: if isAdmin();
    }

    // Categories collection: Public read, Admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners collection: Public read, Admin write
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements collection: Public read, Admin write
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection: Public create & read, Admin update/delete
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // Store Settings collection: Public read, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FCM Device Tokens: Public create/write to subscribe, Admin read
    match /fcm_tokens/{tokenId} {
      allow read, write: if true;
    }

    // Admin FCM Tokens: Admin device registration for instant order push alerts
    match /admin_fcm_tokens/{tokenId} {
      allow read, write: if true;
    }

    // Push Notification Campaigns: Public read (for in-app banners), Admin write
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Order Notifications collection: Public read & write
    match /order_notifications/{orderId} {
      allow read, write: if true;
    }
  }
}
